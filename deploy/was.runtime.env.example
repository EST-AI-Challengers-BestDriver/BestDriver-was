# Copy this file to ~/bestdriver/was.runtime.env on EC2.
# Keep production secrets on the server and never commit them.
#
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/bestdriver
SPRING_DATASOURCE_USERNAME=bestdriver
SPRING_DATASOURCE_PASSWORD=change-me

POSTGRES_DB=bestdriver
POSTGRES_USER=bestdriver
POSTGRES_PASSWORD=bestdriver

CORS_ALLOWED_ORIGINS=https://your-web-domain.example
PREDICTION_MODE=mock
